<thermal version="0.02" product="KOB">

<!--配置需要上传的温度属性信息-->

<sensor_temp name="mtks_usbntc" type="55" enable="true" min_temp="-30" step="5" to_celsius="1000">
    <thresholds>75</thresholds>
</sensor_temp>

<sensor_temp name="shell_frame" type="22" enable="true" min_temp="0" step="5" to_celsius="1000">
    <thresholds>75</thresholds>
</sensor_temp>

<sensor_temp name="shell_front" type="28" enable="true" min_temp="0" step="5" to_celsius="1000">
    <thresholds>75</thresholds>
</sensor_temp>

<sensor_temp name="mtksAP" type="52" enable="true" min_temp="-30" step="5" to_celsius="1000">
    <thresholds>75</thresholds>
</sensor_temp>

<sensor_temp name="mtktsbtsmdpa" type="54" enable="true" min_temp="0" step="5" to_celsius="1000">
    <thresholds>75</thresholds>
</sensor_temp>

<sensor_temp name="battery" type="9" enable="true" min_temp="-20" step="5" to_celsius="1000">
    <thresholds>70</thresholds>
</sensor_temp>

<ambient_calculate_coef>
    <debug>0</debug>
    <nstate>60</nstate>
    <ncalc>6</ncalc>
    <nout>5</nout>
    <deltat>5</deltat>
    <tau>100</tau>
    <epsilon>1</epsilon>
    <interval>500</interval>
    <cur_step>300</cur_step>
    <ntc_step>2000</ntc_step>
    <ntc_rate>75</ntc_rate>
    <version>30</version>
    <para_init_a>2117.2</para_init_a>
    <para_init_b>44.178</para_init_b>
    <para_ac_a>-5850</para_ac_a>
    <para_ac_b>-0.13257</para_ac_b>
    <para_ac_cur>0</para_ac_cur>
    <para_dc_a>-4045.5</para_dc_a>
    <para_dc_b>-0.13765</para_dc_b>
    <para_dc_cur>-0.55487</para_dc_cur>
    <temp_norm>1</temp_norm>
    <amb_max>80000</amb_max>
    <amb_min>-40000</amb_min>
    <amb_range>-40000</amb_range>
    <cur_norm>3800000</cur_norm>
    <sensor_count>4</sensor_count>
    <sensor0 type="battery" alpha="1.08096" beta="1.09134"/>
    <sensor1 type="battery" alpha="0" beta="0"/>
    <sensor2 type="mtktsbtsmdpa" alpha="0.04328" beta="-0.02112"/>
    <sensor3 type="mtktsAP" alpha="-0.07457" beta="-0.04725"/>
</ambient_calculate_coef>

</thermal>