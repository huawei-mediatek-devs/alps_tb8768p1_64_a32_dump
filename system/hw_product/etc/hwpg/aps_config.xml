<?xml version="1.0" encoding="utf-8"?>
<!--
 * aps Config
 * all states definitions at here.
 -->
<aps_config>
    <aps_property_config>
        <property
            key="sys.2dsdr.startratio"
            value="1" />
        <property
            key="sys.2dsdr.pkgname"
            value="*" /> <!-- use * to support all aplications of list -->
        <property
            key="sys.tpdoze.include"
            value="ALL" />
        <property
            key="sys.tpdoze.exclude"
            value="" />
        <property
            key="sys.aps.cust_fps"
            value="60" /> <!-- default fps for all games -->
        <property
            key="sys.aps.cust_sdr_ratio"
            value="1" /> <!-- default sdr ratio for all games -->
    </aps_property_config>

    <aps_app_list version="1">
        
    </aps_app_list>
</aps_config>

