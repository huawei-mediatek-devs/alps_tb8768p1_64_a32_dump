{
    "imports" : [
		"/system/lib/libhwfilter_mtk.so"
	],

    "filters" :
    [
        {
            "id" : "ppsource",
            "type" : "ppsource",
            "captureTotal" : 3
        },

        {
            "id" : "encoder",
            "type" : "mtk_filter_jpeg"
        },

		{
            "id" : "writer",
            "type" : "filewriter"
        },

        {
            "id" : "hdr",
            "type" : "HDR"
        },

        {
            "id" : "thumbnail",
            "type" : "quickthumbnail"
        },

        {
            "id" : "notifier",
            "type" : "thumbnail-notifier"
        },

        {
            "id" : "peek",
            "type" : "peek"
        },

        {
            "id" : "Davinci",
            "type" : "Davinci"
        },

        {
            "id" : "peekMeta",
            "type" : "peek"
        }
    ],

    "connections" :
    [
        {
            "from" :
            {
                "filter" : "ppsource",
                "port" : "out0"
            },

            "to" :
            {
                "filter" : "hdr",
                "port" : "inMain"
            }
        },

        {
            "from" :
            {
                "filter" : "hdr",
