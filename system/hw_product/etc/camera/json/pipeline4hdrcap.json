            }
	},

	{
	    "from" :
            {
                "filter" : "peekMeta",
                "port" : "out"
            },

            "to" :
            {
                "filter" : "hdr",
                "port" : "inMeta"
            }
        },

        {
            "from" :
            {
                "filter" : "hdr",
                "port" : "OutMeta"
            },

            "to" :
            {
                "filter" : "Davinci",
                "port" : "inMeta"
            }
        },

        {
            "from" :
            {
                "filter" : "Davinci",
                "port" : "OutMeta"
            },

           "to" :
           {
                "filter" : "encoder",
                "port" : "inMeta"
           }
        },

    {
            "from" :
            {
                "filter" : "peekMeta",
                "port" : "peek0"
            },

            "to" :
            {
                "filter" : "thumbnail",
                "port" : "inMeta"
            }
        }
    ]
}

