            }
        },

        {
            "from" :
            {
                "filter" : "Davinci",
                "port" : "OutDestyuv"
            },

            "to" :
            {
                "filter" : "encoder",
                "port" : "inMain"
            }
        },

		{
			"from" :
            {
                "filter" : "encoder",
                "port" : "jpeg"
            },

            "to" :
            {
                "filter" : "writer",
                "port" : "in"
            }
	    },

        {
            "from" :
            {
                "filter" : "hdr",
                "port" : "OutQuickThumbnailyuv"
            },

            "to" :
            {
                "filter" : "thumbnail",
                "port" : "inMain"
            }
        },

		{
            "from" :
            {
                "filter" : "thumbnail",
                "port" : "outThumbnail"
            },

            "to" :
            {
                "filter" : "notifier",
